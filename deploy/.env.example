# Never commit .env. Use a random hexadecimal DB password (openssl rand -hex 24).
POSTGRES_PASSWORD=replace_with_random_hex
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
AI_BASE_URL=https://your-provider.example/v1
AI_MODEL=replace_with_supported_model_id
AI_API_KEY=replace_with_provider_key
# Optional, required only with media.enabled: true. Never put this key in YAML.
FAL_KEY=
